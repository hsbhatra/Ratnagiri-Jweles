NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

MONGODB_URI=
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_HASH_SECRET=
# Leave as strict while the frontend calls the API same-origin (Vite proxy / host rewrite)
COOKIE_SAMESITE=strict
# Deployed only: same value as API_SIGNATURE_TOKEN on Netlify (leave empty locally)
EDGE_PROXY_SECRET=

# --- Email (Brevo, every environment) ---------------------------------------------
# Brevo > SMTP & API > API keys. Leave empty locally to print emails in this terminal.
BREVO_API_KEY=
# Must be a sender verified in Brevo (Senders, domains & dedicated IPs > Senders)
EMAIL_FROM=RatnaGiri Jewels <your-verified-sender@gmail.com>
EMAIL_REPLY_TO=

# Without it, OTPs are kept in memory (dev only). Use the rediss:// URL from Upstash.
UPSTASH_REDIS_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_URL=

# Only for `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
