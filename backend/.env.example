NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

MONGODB_URI=
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_HASH_SECRET=
# Leave as strict while the frontend calls the API same-origin (Vite proxy / host rewrite)
COOKIE_SAMESITE=strict
# Deployed only: same value as API_SIGNATURE_TOKEN on Netlify (leave empty locally)
EDGE_PROXY_SECRET=

# --- Email ---------------------------------------------------------------------
# Resend is the provider on every environment (dev, testing, production).
# Until your domain is verified in Resend: EMAIL_FROM stays onboarding@resend.dev and
# emails only reach the email address you signed up to Resend with.
RESEND_API_KEY=
EMAIL_FROM=RatnaGiri Jewels <onboarding@resend.dev>
EMAIL_REPLY_TO=
# Optional, local development only: Gmail SMTP for emailing other addresses before the
# domain is verified (Google Account > 2-Step Verification > App passwords).
# Used only when EMAIL_PROVIDER=smtp or RESEND_API_KEY is empty. Never on Render.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Without it, OTPs are kept in memory (dev only). Use the rediss:// URL from Upstash.
UPSTASH_REDIS_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_URL=

# Only for `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
